# OSINT Globe Dashboard Environment Variables

# Windy Webcams API
# Get from https://www.windy.com/-Webcams-api-webcams-api?webcams-api
WINDY_WEBCAMS_API_KEY=

# OpenSky Network (ADS-B aviation)
# Free tier: https://opensky-network.org/apidoc
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Maritime AIS Providers (choose one)
# Spire Maritime: https://spire.com/maritime/
SPIRE_API_KEY=
SPIRE_API_URL=https://data-api.spire.com/maritime/v1

# MarineTraffic: https://www.marinetraffic.com/en/data/apis
MARINETRAFFIC_API_KEY=

# exactEarth: https://www.exactearth.com/
EXACTEARTH_API_KEY=

# Optional: Nominatim geocoding (no key required, respect rate limits)
# https://nominatim.org/release-docs/develop/api/Overview/

# Optional: TLE satellite data (CelesTrak)
# https://celestrak.org/
