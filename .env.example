# ---------------------------------------------------------------------------
# OSINT Globe — optional server-side keys
#
# Every layer boots without any key. These are only needed for the feeds that
# have no keyless equivalent (AIS ships, Windy cameras, FIRMS hotspots) or to
# raise rate limits. You can also paste them into the in-app POWER UP panel,
# which stores them in the browser and sends them to /api/* routes only.
# ---------------------------------------------------------------------------

# --- Public cameras ---------------------------------------------------------
# https://api.windy.com/keys
WINDY_WEBCAMS_API_KEY=

# --- Street-level imagery ---------------------------------------------------
# Free token from the Mapillary developer dashboard (client tokens start with MLY|)
# https://www.mapillary.com/dashboard/developers
MAPILLARY_ACCESS_TOKEN=
MAPILLARY_TOKEN=

# --- Maritime AIS (pick one provider) ---------------------------------------
# AISHub (free registration, bbox queries): https://www.aishub.net/api
# Spire: https://spire.com/maritime/
# MarineTraffic: https://www.marinetraffic.com/en/data/apis
# Datalastic: https://datalastic.com/
AIS_API_KEY=
SPIRE_API_KEY=
MARINETRAFFIC_API_KEY=

# --- NASA FIRMS wildfire hotspots (upgrades the keyless EONET wildfires) ----
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
NASA_FIRMS_KEY=

# --- OpenSky (raises the anonymous request budget for live flights) ---------
# https://opensky-network.org/index.php?option=com_users&view=registration
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# ---------------------------------------------------------------------------
# No key required: USGS earthquakes, NASA EONET hazards, CelesTrak TLEs,
# adsb.lol / airplanes.live (incl. military traffic), Radio-Browser,
# Launch Library 2, Open Notify (ISS), Nominatim geocoding, OSM Overpass.
# ---------------------------------------------------------------------------
